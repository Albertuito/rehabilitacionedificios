{
  "name": "reformasafiliado",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/tailwind-sources.mjs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint src --ext .js,.ts,.tsx,.astro",
    "test": "tsx --test tests/unit/core.test.ts",
    "test:e2e": "playwright test",
    "check:content-similarity": "node scripts/check-similarity.mjs",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:schema": "node scripts/check-schema.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "og:images": "node scripts/og-images.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "js-yaml": "^5.4.2",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
