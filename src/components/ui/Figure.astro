---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  credit: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  ratio?: string;
  bleed?: boolean;
}
const {
  src,
  alt,
  caption,
  credit,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  class: className = '',
  ratio = '4 / 5',
  bleed = false,
} = Astro.props;
---

<figure class:list={['ed-figure', bleed && 'is-bleed', className]}>
  <div class="ed-figure-frame" style={`aspect-ratio:${ratio}`}>
    <Picture
      src={src}
      alt={alt}
      width={src.width}
      height={src.height}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="ed-figure-img"
      pictureAttributes={{ class: 'ed-figure-picture', style: `aspect-ratio:${ratio}` }}
    />
  </div>
  <figcaption class:list={[bleed && 'ed-container']}>
    <span>{caption}</span>
    <span>Foto: {credit}</span>
  </figcaption>
</figure>

<style>
  .ed-figure-img,
  .ed-figure-picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .is-bleed {
    width: 100%;
  }

  .is-bleed .ed-figure-frame {
    border-radius: 0;
  }

  .is-bleed figcaption {
    margin-top: 0.85rem;
  }
</style>
