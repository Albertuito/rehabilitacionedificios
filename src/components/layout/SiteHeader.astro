---
import { PRIMARY_CTA } from '../../config/affiliate.config';
import AffiliateCta from '../conversion/AffiliateCta.astro';
import BrandMark from '../brand/BrandMark.astro';

const path = Astro.url.pathname;
const links: { href: string; label: string; exact?: boolean }[] = [
  { href: '/servicios/', label: 'Servicios', exact: true },
  { href: '/servicios/rehabilitacion-fachadas/', label: 'Fachadas' },
  { href: '/servicios/reparacion-cubiertas-tejados/', label: 'Cubiertas' },
  { href: '/precios/', label: 'Precios' },
  { href: '/provincias/', label: 'Provincias' },
  { href: '/guias/', label: 'Guías' },
  { href: '/como-funciona/', label: 'Cómo funciona' },
];
const isActive = (href: string, exact?: boolean) => (exact ? path === href : path.startsWith(href));
---

<header class="site-header" id="cabecera">
  <div class="ed-container site-header__bar">
    <a href="/" class="site-header__brand" aria-label="Rehabilitando Edificios, inicio">
      <BrandMark compact />
    </a>
    <nav class="site-header__nav" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['site-header__link', isActive(link.href, link.exact) && 'is-active']}
            aria-current={isActive(link.href, link.exact) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="site-header__actions">
      <AffiliateCta clickref="header_cta" label={PRIMARY_CTA} placement="header" class="ed-btn ed-btn-primary site-header__cta" />
      <button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="menu" data-nav-toggle>
        <span class="sr-only">Abrir menú</span>
        <span aria-hidden="true" class="site-header__burger"></span>
      </button>
    </div>
  </div>
  <nav class="site-header__drawer" id="menu" aria-label="Móvil" hidden>
    {
      links.map((link) => (
        <a href={link.href} class="site-header__drawer-link">
          {link.label}
        </a>
      ))
    }
    <div class="site-header__drawer-cta">
      <AffiliateCta clickref="header_cta" label={PRIMARY_CTA} placement="header" class="ed-btn ed-btn-primary" />
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('cabecera');
  const toggle = document.querySelector('[data-nav-toggle]');
  const menu = document.getElementById('menu');

  const setStuck = () => {
    header?.classList.toggle('is-stuck', window.scrollY > 8);
  };
  setStuck();
  window.addEventListener('scroll', setStuck, { passive: true });

  const setOpen = (open) => {
    if (menu) menu.hidden = !open;
    toggle?.setAttribute('aria-expanded', open ? 'true' : 'false');
    document.body.classList.toggle('nav-open', open);
    if (open) {
      const first = menu?.querySelector('a');
      first instanceof HTMLElement && first.focus();
    } else if (toggle instanceof HTMLButtonElement) {
      toggle.focus();
    }
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--color-white);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-stuck {
    border-bottom-color: var(--color-border);
    box-shadow: var(--shadow-hair);
  }

  .site-header__bar {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: var(--header-h);
  }

  .site-header__brand {
    text-decoration: none;
    min-width: 0;
  }

  .site-header__nav {
    display: none;
    justify-content: center;
    align-items: center;
    gap: 0.15rem 1.05rem;
  }

  .site-header__link {
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    padding: 0.35rem 0;
    border-bottom: 2px solid transparent;
    white-space: nowrap;
    color: var(--color-navy-800);
  }

  .site-header__link:hover,
  .site-header__link.is-active {
    border-bottom-color: var(--color-orange-500);
    color: var(--color-navy-950);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
  }

  .site-header__actions :global(.site-header__cta) {
    min-height: 2.55rem;
    padding-inline: 0.95rem;
    font-size: 0.84rem;
    white-space: nowrap;
  }

  .site-header__toggle {
    width: 2.55rem;
    height: 2.55rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-white);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .site-header__burger,
  .site-header__burger::before,
  .site-header__burger::after {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--color-navy-900);
    position: relative;
  }

  .site-header__burger::before,
  .site-header__burger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .site-header__burger::before {
    top: -5px;
  }

  .site-header__burger::after {
    top: 5px;
  }

  .site-header__drawer {
    border-top: var(--rule);
    background: var(--color-white);
    padding: 0.35rem 1.25rem 1.25rem;
  }

  .site-header__drawer[hidden] {
    display: none;
  }

  .site-header__drawer-link {
    display: block;
    padding-block: 0.9rem;
    text-decoration: none;
    border-bottom: var(--rule);
    font-weight: 650;
  }

  .site-header__drawer-cta {
    padding-top: 1rem;
  }

  .site-header__drawer-cta :global(.ed-btn) {
    width: 100%;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  @media (min-width: 1024px) {
    .site-header__nav {
      display: flex;
    }

    .site-header__toggle {
      display: none;
    }

    .site-header__actions :global(.site-header__cta) {
      min-height: 2.7rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 1023px) {
    .site-header__actions :global(.site-header__cta) {
      display: none;
    }

    .site-header__bar {
      grid-template-columns: 1fr auto;
    }
  }
</style>
