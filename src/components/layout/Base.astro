---
import '../../styles/global.css';
import { absoluteUrl, siteConfig } from '../../config/site.config';
import ConsentSheet from '../ui/ConsentSheet';

interface Props {
  title: string;
  description: string;
  canonical: string;
  robots?: string;
  ogImage?: string;
  jsonLd?: string;
  publishedAt?: string;
  updatedAt?: string;
}

const {
  title,
  description,
  canonical,
  robots = 'index,follow',
  ogImage = absoluteUrl(siteConfig.defaults.ogImage),
  jsonLd,
  publishedAt,
  updatedAt,
} = Astro.props;
const ga = siteConfig.analytics.gaMeasurementId;
const gsc = siteConfig.analytics.searchConsole;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={siteConfig.brand.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="manifest" href="/site.webmanifest" />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {updatedAt && <meta property="article:modified_time" content={updatedAt} />}
    {gsc && <meta name="google-site-verification" content={gsc} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/newsreader-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/manrope-500.woff2" as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {siteConfig.analytics.gtmId && <meta name="gtm-id" content={siteConfig.analytics.gtmId} />}
    {ga && <meta name="ga-id" content={ga} />}
    {siteConfig.analytics.clarityId && <meta name="clarity-id" content={siteConfig.analytics.clarityId} />}
  </head>
  <body class="ed-page">
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot name="header" />
    <slot />
    <slot name="footer" />
    <ConsentSheet client:idle brand={siteConfig.brand.name} />
    <script>
      import '../../scripts/tracking';
    </script>
  </body>
</html>
