---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  credit: string;
  widths?: number[];
  sizes?: string;
  priority?: boolean;
  class?: string;
  ratio?: string;
}
const {
  src,
  alt,
  caption,
  credit,
  widths = [480, 800, 1200, 1600],
  sizes = '(min-width: 1024px) 50vw, 100vw',
  priority = false,
  class: className = '',
  ratio = '4 / 5',
} = Astro.props;
---

<figure class:list={['m-0', className]}>
  <div class="overflow-hidden bg-border" style={`aspect-ratio:${ratio}`}>
    <Picture
      src={src}
      alt={alt}
      width={src.width}
      height={src.height}
      widths={widths}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={78}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="h-full w-full object-cover"
      pictureAttributes={{ class: 'block h-full w-full', style: `aspect-ratio:${ratio}` }}
    />
  </div>
  <figcaption class="mt-3 flex flex-wrap justify-between gap-2 text-[0.8rem] text-muted">
    <span>{caption}</span>
    <span>Foto: {credit}</span>
  </figcaption>
</figure>
