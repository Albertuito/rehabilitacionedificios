---
interface Props {
  ids: string[];
}
const catalog: Record<string, { title: string; url: string; consultedAt: string }> = {
  F1: { title: 'Awin · Programa Habitissimo ES', url: 'https://www.awin.com/', consultedAt: '2026-09-21' },
  F6: { title: 'Habitissimo · Precios para reformar una casa', url: 'https://www.habitissimo.es/precios/reformar-casa', consultedAt: '2026-09-21' },
  F7: { title: 'AEPD · Guía de cookies', url: 'https://www.aepd.es/guias/guia-cookies.pdf', consultedAt: '2026-09-21' },
};
const { ids } = Astro.props;
const sources = ids.map((id) => ({ id, ...catalog[id] })).filter((item) => item.title);
---

<section class="border-t border-border pt-10">
  <h2 class="ed-h3">Fuentes consultadas</h2>
  <ul class="pl-5">
    {
      sources.map((source) => (
        <li>
          <a class="ed-link" href={source.url} rel="noopener">{source.title}</a> · consulta {source.consultedAt}
        </li>
      ))
    }
  </ul>
</section>
