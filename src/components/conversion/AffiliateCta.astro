---
import { buildAffiliateUrl, assertClickref } from '../../lib/affiliate';
import { getClickRef } from '../../data/tracking';

interface Props {
  clickref: string;
  label: string;
  class?: string;
  placement?: string;
  service?: string;
  location?: string;
  variant?: 'primary' | 'ghost' | 'link';
}
const {
  clickref,
  label,
  class: className,
  placement,
  service,
  location,
  variant = 'primary',
} = Astro.props;
assertClickref(clickref);
const record = getClickRef(clickref);
const href = buildAffiliateUrl(clickref);
const visual =
  className ??
  (variant === 'link' ? 'ed-link' : variant === 'ghost' ? 'ed-btn ed-btn-ghost' : 'ed-btn ed-btn-primary');
---

<a
  class={visual}
  href={href}
  rel="sponsored noopener"
  target="_blank"
  data-event="affiliate_click"
  data-clickref={clickref}
  data-placement={placement ?? record?.placement}
  data-service={service ?? record?.service ?? ''}
  data-location={location ?? record?.location ?? ''}
>
  {label}
</a>
