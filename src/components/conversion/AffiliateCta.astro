---
import { buildAffiliateUrl, assertClickref } from '../../lib/affiliate';
import { affiliateConfig, PRIMARY_CTA } from '../../config/affiliate.config';
import { getClickRef } from '../../data/tracking';

interface Props {
  clickref: string;
  label?: string;
  class?: string;
  placement?: string;
  service?: string;
  location?: string;
  variant?: 'primary' | 'ghost' | 'link';
}
const {
  clickref,
  label = PRIMARY_CTA,
  class: className,
  placement,
  service,
  location,
  variant = 'primary',
} = Astro.props;
assertClickref(clickref);
const record = getClickRef(clickref);
const resolvedPlacement = placement ?? record?.placement;
const resolvedService = service ?? record?.service ?? '';
const resolvedLocation = location ?? record?.location ?? '';
const href = buildAffiliateUrl(clickref, {
  placement: resolvedPlacement,
  service: resolvedService || undefined,
  location: resolvedLocation || undefined,
});
const visual =
  className ??
  (variant === 'link' ? 'ed-link' : variant === 'ghost' ? 'ed-btn ed-btn-ghost' : 'ed-btn ed-btn-primary');
---

{
  href ? (
    <a
      class={visual}
      href={href}
      rel={affiliateConfig.rel}
      data-event="affiliate_click"
      data-clickref={clickref}
      data-placement={resolvedPlacement}
      data-service={resolvedService}
      data-location={resolvedLocation}
    >
      {label}
    </a>
  ) : (
    <span class={`${visual} is-disabled`} aria-disabled="true" title={affiliateConfig.disabledReason}>
      {label}
    </span>
  )
}
